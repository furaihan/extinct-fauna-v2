# Local PostgreSQL. Password must not contain @ / # / ? (breaks URL parsing).
DATABASE_URL=postgresql://postgres:password@localhost:5432/extinct-fauna-v2

# 32+ random chars for the signed session cookie.
SESSION_SECRET=change-me-32-chars-minimum

# Seeded admin account (created on db:seed).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Legacy-only password salts for pre-migration bcrypt hashes (PREFIX_SALT + password + SUFFIX_SALT).
# Kept solely to verify old accounts that have not logged in yet.
PREFIX_SALT=
SUFFIX_SALT=

# Argon2id parameters for newly created hashes (OWASP defaults: 64 MiB memory, 3 iterations).
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
