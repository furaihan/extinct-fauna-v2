# Local PostgreSQL. Password must not contain @ / # / ? (breaks URL parsing).
DATABASE_URL=postgresql://postgres:password@localhost:5432/extinct-fauna-v2

# 32+ random chars for the signed session cookie.
SESSION_SECRET=change-me-32-chars-minimum

# Seeded admin account (created on db:seed).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Password salts, inherited from the legacy fp-pemrog-web server. Legacy
# accounts hashed PREFIX_SALT + password + SUFFIX_SALT, so these must match to
# let old accounts log in. Keep them set so legacy and new hashes share one path.
PREFIX_SALT=
SUFFIX_SALT=

# bcrypt cost for newly created hashes (4-31). Legacy hashes carry their own
# cost ($2b$10$) and keep verifying, so raising this does not lock anyone out.
BCRYPT_COST=12

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
