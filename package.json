{
  "name": "extinct-fauna",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bunx --bun vite dev --port 3100",
    "generate-routes": "tsr generate",
    "build": "bunx --bun vite build",
    "start": "bun server.ts",
    "preview": "vite preview",
    "typecheck": "bunx --bun tsc --noEmit",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:import": "bun src/db/import-old-dump.ts",
    "db:seed": "bun src/db/seeder/index.ts",
    "db:setup": "bun run src/db/migrate.ts && bun src/db/import-old-dump.ts && bun src/db/seeder/index.ts",
    "db:reset": "bun src/db/reset-db.ts --force"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dompurify": "^3.4.16",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.48.0",
    "motion": "^14.0.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "latest",
    "@types/bun": "^1.4.2",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
