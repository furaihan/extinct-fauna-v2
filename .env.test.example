# E2E environment. Copy to `.env.test` and point DATABASE_URL at a dedicated
# test database — the quiz specs insert rows and must not touch dev data.

DATABASE_URL=postgresql://postgres:password@localhost:5432/fauna_test

# 32+ random chars for the signed session cookie.
SESSION_SECRET=fauna-e2e-session-secret-at-least-32-characters-long

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

NODE_ENV=test
PORT=3101
LOG_LEVEL=warn

PREFIX_SALT=
SUFFIX_SALT=
